{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crabbro.dev/schemas/gateway-plan.v1.json",
  "title": "Crabbro gateway plan",
  "description": "Schema for an API-key coding plan or decision backend under ~/.crabbro/gateway/plans/<id>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "endpoints", "models"],
  "oneOf": [{"required": ["credential"]}, {"required": ["credentials"]}, {"required": ["siwc"]}, {"required": ["auth"]}],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "enabled": { "type": "boolean" },
    "direct": { "type": "object", "additionalProperties": false, "description": "Direct <plan>/<model> addressing. It remains single-target with maxAttempts 1 unless fallbackRoute explicitly opts into failover.", "properties": {
      "enabled": { "type": "boolean" },
      "profiles": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } },
      "fallbackRoute": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "Opt-in explicit fallback for direct addressing. Names an enabled same-family route whose targets are appended after the direct target. Omitted (the default) keeps direct addressing single-target with maxAttempts 1." }
    } },
    "description": { "type": "string", "maxLength": 1024 },
    "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "auth": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": { "enum": ["api-key", "key-pool", "oauth-siwc"] },
        "ref": { "$ref": "#/$defs/secretRef" },
        "refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/secretRef" } },
        "strategy": { "enum": ["priority", "round-robin", "quota-weighted"] },
        "sessionRef": { "$ref": "#/$defs/secretRef" },
        "hostIdRef": { "$ref": "#/$defs/secretRef" }
      },
      "oneOf": [
        { "properties": { "kind": { "const": "api-key" } }, "required": ["ref"], "not": { "anyOf": [{"required": ["refs"]}, {"required": ["strategy"]}, {"required": ["sessionRef"]}, {"required": ["hostIdRef"]}] } },
        { "properties": { "kind": { "const": "key-pool" } }, "required": ["refs"], "not": { "anyOf": [{"required": ["ref"]}, {"required": ["sessionRef"]}, {"required": ["hostIdRef"]}] } },
        { "properties": { "kind": { "const": "oauth-siwc" } }, "required": ["sessionRef", "hostIdRef"], "not": { "anyOf": [{"required": ["ref"]}, {"required": ["refs"]}, {"required": ["strategy"]}] } }
      ]
    },
    "credential": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "siwc": { "type": "object", "additionalProperties": false, "required": ["sessionRef", "hostIdRef"], "properties": {
      "sessionRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
      "hostIdRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
    } },
    "credentials": { "type": "object", "additionalProperties": false, "required": ["refs"], "properties": {
      "strategy": { "enum": ["priority", "round-robin", "quota-weighted"] },
      "refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" } }
    } },
    "proxyUrl": { "type": "string", "format": "uri", "pattern": "^(https?|socks5h?)://" },
    "timeout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttft": { "$ref": "#/$defs/duration" },
        "idle": { "$ref": "#/$defs/duration" }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttl": { "$ref": "#/$defs/duration" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rpm": { "type": "integer", "minimum": 1 },
        "tpm": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "windows": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["duration"],
            "anyOf": [
              { "required": ["maxTokens"] },
              { "required": ["maxRequests"] }
            ],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 64 },
              "duration": { "$ref": "#/$defs/duration" },
              "maxTokens": { "type": "integer", "minimum": 1 },
              "maxRequests": { "type": "integer", "minimum": 1 },
              "resetSchedule": { "type": "string", "minLength": 1, "maxLength": 64 },
              "mode": { "enum": ["soft", "hard"] }
            }
          }
        }
      }
    },
    "autoReset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "scopes": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["fiveHour", "weekly"] }
        },
        "expiringWithin": { "$ref": "#/$defs/duration" },
        "minInterval": { "$ref": "#/$defs/duration" },
        "safeguard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "leadTime": { "$ref": "#/$defs/duration" },
            "minUsedPercent": { "type": "number", "minimum": 1, "maximum": 99 }
          }
        }
      }
    },
    "quotaReminder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leadTime": { "$ref": "#/$defs/duration" }
      }
    },
    "endpoints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "openai-chat": { "$ref": "#/$defs/endpoint" },
        "openai-responses": { "$ref": "#/$defs/endpoint" },
        "anthropic": { "$ref": "#/$defs/endpoint" },
        "gemini": { "$ref": "#/$defs/endpoint" },
        "typesafe-jev": { "$ref": "#/$defs/endpoint" },
        "openai-decisions": { "$ref": "#/$defs/endpoint" },
        "gemini-decisions": { "$ref": "#/$defs/endpoint" }
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 128 },
      "additionalProperties": { "$ref": "#/$defs/modelSpec" }
    }
  },
  "$defs": {
    "secretRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "requestTransform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stripHeaders": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "setHeaders": { "type": "object", "additionalProperties": { "type": "string" } },
        "path": { "type": "string", "pattern": "^(/.*)?$" },
        "pathPrefix": { "type": "string", "pattern": "^(/.*)?$" },
        "query": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
        "dropBodyFields": { "type": "array", "items": { "$ref": "#/$defs/bodyPath" } },
        "renameBodyFields": { "type": "object", "propertyNames": { "$ref": "#/$defs/bodyPath" }, "additionalProperties": { "$ref": "#/$defs/bodyPath" } },
        "setBodyFields": { "type": "object", "propertyNames": { "$ref": "#/$defs/bodyPath" } }
      }
    },
    "responseTransform": {
      "type": "object",
      "additionalProperties": false,
      "not": { "required": ["unwrapPath", "extractField"] },
      "properties": {
        "stripHeaders": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "setHeaders": { "type": "object", "additionalProperties": { "type": "string" } },
        "unwrapPath": { "$ref": "#/$defs/bodyPath" },
        "extractField": { "$ref": "#/$defs/bodyPath" },
        "dropBodyFields": { "type": "array", "items": { "$ref": "#/$defs/bodyPath" } },
        "renameBodyFields": { "type": "object", "propertyNames": { "$ref": "#/$defs/bodyPath" }, "additionalProperties": { "$ref": "#/$defs/bodyPath" } },
        "setBodyFields": { "type": "object", "propertyNames": { "$ref": "#/$defs/bodyPath" } }
      }
    },
    "bodyPath": { "type": "string", "pattern": "^[^.]+(\\.[^.]+)*$" },
    "protocol": { "enum": ["openai-chat", "openai-responses", "anthropic", "gemini", "typesafe-jev", "openai-decisions", "gemini-decisions"] },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl"],
      "properties": {
        "baseUrl": { "type": "string", "pattern": "^https?://" },
        "authHeader": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authPrefix": { "type": "string", "maxLength": 64 },
        "headers": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": { "type": "string" }
        },
        "apiVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "requestTransform": { "$ref": "#/$defs/requestTransform" },
        "responseTransform": { "$ref": "#/$defs/responseTransform" }
      }
    },
    "modelSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoints": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/protocol" } },
        "tier": { "enum": ["fast", "strong", "frontier"] },
        "codingScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "contextWindow": { "type": "integer", "minimum": 1024 },
        "maxOutputTokens": { "type": "integer", "minimum": 1 },
        "cacheTtl": { "$ref": "#/$defs/duration" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tools": { "type": "boolean" },
            "vision": { "type": "boolean" },
            "thinking": { "type": "boolean" },
            "structuredOutput": { "type": "boolean" },
            "promptCache": { "type": "boolean" }
          }
        },
        "extraBody": {
          "type": "object",
          "additionalProperties": true
        },
        "requestTransform": { "$ref": "#/$defs/requestTransform" },
        "responseTransform": { "$ref": "#/$defs/responseTransform" }
      }
    }
  }
}
