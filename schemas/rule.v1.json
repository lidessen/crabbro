{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chiling.dev/schemas/rule.v1.json",
  "title": "Chiling rule",
  "description": "Proposed schema for a YAML rule after it is parsed to JSON. Not enforced by the daemon yet. Semantic checks (installed plugins, observe-only parallel stages, expression grammar, cycles) run after this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "on"],
  "anyOf": [
    { "required": ["request"] },
    { "required": ["response"] },
    { "required": ["frame"] }
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "priority": { "type": "integer" },
    "failureMode": { "enum": ["fail-open", "fail-closed"] },
    "on": { "$ref": "#/$defs/match" },
    "request": { "$ref": "#/$defs/phase" },
    "response": { "$ref": "#/$defs/phase" },
    "frame": { "$ref": "#/$defs/phase" }
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": { "$ref": "#/$defs/requestMatch" },
        "hook": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["request"] },
        { "required": ["hook"] }
      ]
    },
    "requestMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string" },
        "host": { "type": "string" },
        "path": { "type": "string" },
        "pathPrefix": { "type": "string" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline"],
      "properties": {
        "pipeline": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stage" }
        }
      }
    },
    "stage": {
      "oneOf": [
        { "$ref": "#/$defs/action" },
        { "$ref": "#/$defs/switch" },
        { "$ref": "#/$defs/parallel" }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "if": { "type": "string", "minLength": 1 },
        "uses": { "type": "string", "minLength": 1 },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "script"],
          "properties": {
            "runtime": { "const": "goja" },
            "script": { "type": "string", "minLength": 1 }
          }
        },
        "with": { "type": "object" },
        "continueOnError": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 2000 }
      },
      "oneOf": [
        { "required": ["uses"], "not": { "required": ["run"] } },
        { "required": ["run"], "not": { "required": ["uses"] } }
      ]
    },
    "switch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["switch", "cases"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "if": { "type": "string", "minLength": 1 },
        "switch": { "type": "string", "minLength": 1 },
        "cases": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/pipeline" }
        },
        "default": { "$ref": "#/$defs/pipeline" }
      }
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parallel"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "if": { "type": "string", "minLength": 1 },
        "parallel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stages"],
          "properties": {
            "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 2000 },
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/action" }
            }
          }
        }
      }
    },
    "pipeline": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    }
  }
}
