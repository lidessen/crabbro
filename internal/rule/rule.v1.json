{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crabbro.dev/schemas/rule.v1.json",
  "title": "Crabbro rule",
  "description": "Proposed schema for a YAML rule after parse. Not enforced by the daemon yet. A later pass checks expression grammar, installed instances, observe-only parallel stages, and hook cycles. Diagnostics name the file and a JSON path. They do not echo values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "on"],
  "anyOf": [
    { "required": ["request"] },
    { "required": ["response"] },
    { "required": ["frame"] }
  ],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "enabled": { "type": "boolean" },
    "description": { "type": "string", "maxLength": 1024 },
    "priority": { "type": "integer" },
    "failureMode": { "enum": ["fail-open", "fail-closed"] },
    "timeout": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
    "on": { "$ref": "#/$defs/match" },
    "vars": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true
    },
    "request": { "$ref": "#/$defs/phase" },
    "response": { "$ref": "#/$defs/phase" },
    "frame": { "$ref": "#/$defs/phase" }
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": { "$ref": "#/$defs/requestMatch" },
        "hook": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["request"] },
        { "required": ["hook"] }
      ]
    },
    "requestMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string" },
        "host": { "type": "string" },
        "path": { "type": "string" },
        "pathPrefix": { "type": "string" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline"],
      "properties": {
        "pipeline": { "$ref": "#/$defs/pipeline" }
      }
    },
    "pipeline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/stage" }
    },
    "stage": {
      "oneOf": [
        { "$ref": "#/$defs/action" },
        { "$ref": "#/$defs/select" },
        { "$ref": "#/$defs/parallel" }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
        "if": { "type": "string", "minLength": 1 },
        "uses": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$" },
        "instance": { "type": "string", "minLength": 1 },
        "middleware": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["plugin", "instance", "name"],
            "properties": {
              "plugin": { "type": "string" },
              "instance": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "script"],
          "properties": {
            "runtime": { "const": "goja" },
            "script": { "type": "string", "minLength": 1 }
          }
        },
        "with": { "type": "object" },
        "env": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "continueOnError": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 2000 }
      },
      "allOf": [
        {
          "if": { "properties": { "uses": { "const": "crabbro.gateway-offload" } }, "required": ["uses"] },
          "then": { "required": ["with"], "properties": { "with": { "type": "object", "required": ["protocol", "model"], "properties": { "protocol": { "enum": ["responses", "anthropic-messages"] }, "model": { "type": "string", "pattern": "^\\S(.*\\S)?$" } } } } }
        },
        {
          "if": { "properties": { "uses": { "const": "crabbro.respond-frame" } }, "required": ["uses"] },
          "then": { "required": ["with"], "properties": { "with": { "type": "object", "required": ["payload"], "properties": { "payload": { "type": "string", "maxLength": 65536 } } } } }
        }
      ],
      "oneOf": [
        { "required": ["uses"], "not": { "required": ["run"] } },
        { "required": ["run"], "not": { "required": ["uses"] } }
      ]
    },
    "select": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "select"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
        "if": { "type": "string", "minLength": 1 },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cases"],
          "properties": {
            "cases": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "if", "pipeline"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
                  "if": { "type": "string", "minLength": 1 },
                  "pipeline": { "$ref": "#/$defs/pipeline" }
                }
              }
            },
            "default": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pipeline"],
              "properties": {
                "name": { "type": "string" },
                "pipeline": { "$ref": "#/$defs/pipeline" }
              }
            }
          }
        }
      }
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parallel"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
        "if": { "type": "string", "minLength": 1 },
        "parallel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stages"],
          "properties": {
            "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 2000 },
            "stages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "$ref": "#/$defs/action" }
            }
          }
        }
      }
    }
  }
}
