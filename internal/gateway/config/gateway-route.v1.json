{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crabbro.dev/schemas/gateway-route.v1.json",
  "title": "Crabbro gateway route",
  "description": "Schema for a virtual model route and failover pool under ~/.crabbro/gateway/routes/<id>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "match", "targets"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "enabled": { "type": "boolean" },
    "description": { "type": "string", "maxLength": 1024 },
    "priority": { "type": "integer" },
    "family": { "enum": ["generative", "decision"] },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
        },
        "protocols": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/protocol" }
        },
        "models": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": { "enum": ["balanced", "quality-first", "burn-expiring", "strict-failover"] },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quality": { "type": "number", "minimum": 0, "maximum": 5 },
            "cache": { "type": "number", "minimum": 0, "maximum": 5 },
            "quota": { "type": "number", "minimum": 0, "maximum": 5 },
            "protocol": { "type": "number", "minimum": 0, "maximum": 5 }
          }
        },
        "preferNativeProtocol": { "type": "boolean" },
        "allowCrossProtocol": { "type": "boolean" },
        "allowEmulation": { "type": "boolean" },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 16 },
        "cacheTtlOverride": { "$ref": "#/$defs/duration" },
        "semanticTiering": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "decisionRoute": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
            "timeout": { "$ref": "#/$defs/duration" },
            "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "maxCacheGravity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plan", "model"],
        "properties": {
          "plan": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "model": { "type": "string", "minLength": 1, "maxLength": 128 },
          "endpointProtocol": { "$ref": "#/$defs/protocol" },
          "priority": { "type": "integer" },
          "weight": { "type": "number", "minimum": 0, "maximum": 100 },
          "enabled": { "type": "boolean" },
          "minContextTokens": { "type": "integer", "minimum": 0 },
          "maxContextTokens": { "type": "integer", "minimum": 1 },
          "whenTier": {
            "type": "array",
            "maxItems": 3,
            "items": { "$ref": "#/$defs/tier" }
          }
        }
      }
    }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d)$"
    },
    "protocol": {
      "enum": ["openai-chat", "openai-responses", "anthropic", "gemini", "typesafe-jev"]
    },
    "tier": {
      "enum": ["fast", "strong", "frontier"]
    }
  }
}
